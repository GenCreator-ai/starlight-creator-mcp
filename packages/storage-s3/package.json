{
  "name": "@starlight-intelligence/creator-storage-s3",
  "version": "0.1.0",
  "description": "S3-compatible storage connector (AWS S3, Cloudflare R2, MinIO) for the creator substrate: content-addressed uploads and public or presigned URLs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/starlight-creator-mcp.git",
    "directory": "packages/storage-s3"
  },
  "homepage": "https://github.com/frankxai/starlight-creator-mcp",
  "author": "Frank Riemer <https://frankx.ai>",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@starlight-intelligence/creator-core": "workspace:*",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
